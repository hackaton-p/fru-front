# URL base del API NestJS (solo servidor, nunca se expone al navegador)
API_URL=http://localhost:3000
# URL pública de este front: Better Auth exige un Origin confiable en los POST
# a /api/auth/* (CSRF), y un fetch servidor-a-servidor no lo manda solo.
APP_URL=http://localhost:3001
# true = usa datos mock en memoria; false = login real contra Better Auth
API_MOCK=true
API_TIMEOUT_MS=10000
# Cookie donde se guarda el token de sesión (no es un JWT propio) tras el login
AUTH_COOKIE_NAME=access_token
